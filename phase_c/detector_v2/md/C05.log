# Detector v2 structure rebuild of one Phase C production point
# (phase_c/production): same cell (4x4x24 cells), potential, seed and
# preparation as in.mp_kappa2 (deck std) or in.mp_amorph (deck amorph) up to
# the end of the first NPT equilibration, then 10 ps more NPT with the
# volume averaged and a dump every 2 ps (6 frames). No heat flux, no kappa.
# Output: MPT_VOL_ATOM (A^3 per atom, NPT average) and the dump.
variable x     index 0.5
variable T     index 300
variable seed  index 2003
variable phase index crystal
variable out   index s
units metal
boundary p p p
variable a0 equal 5.431+(5.658-5.431)*v_x
lattice diamond ${a0}
lattice diamond 5.472995
Lattice spacing in x,y,z = 5.472995 5.472995 5.472995
region box block 0 4 0 4 0 24
create_box 2 box
Created orthogonal box = (0 0 0) to (21.89198 21.89198 131.35188)
  1 by 1 by 1 MPI processor grid
create_atoms 1 box
Created 3072 atoms
  using lattice units in orthogonal box = (0 0 0) to (21.89198 21.89198 131.35188)
  create_atoms CPU = 0.000 seconds
set type 1 type/fraction 2 ${x} ${seed}
set type 1 type/fraction 2 0.185 ${seed}
set type 1 type/fraction 2 0.185 1006
Setting atom values ...
  571 settings made for type/fraction
mass 1 28.0855
mass 2 72.63
pair_style tersoff
pair_coeff * * SiCGe_GeC.tersoff Si(D) Ge
Reading tersoff potential file SiCGe_GeC.tersoff with DATE: 2009-03-18
timestep 0.001
thermo 10000
if "${phase} == amorph" then   "velocity all create 7000 ${seed} dist gaussian"   "fix melt all npt temp 3500 3500 0.1 iso 0.0 0.0 1.0"   "run 50000" "unfix melt"   "fix quench all npt temp 3500 ${T} 0.1 iso 0.0 0.0 1.0"   "run 100000" "unfix quench"   "fix npt all npt temp ${T} ${T} 0.1 iso 0.0 0.0 1.0"   "run 50000" else   "velocity all create $(2*v_T) ${seed} dist gaussian"   "fix npt all npt temp ${T} ${T} 0.1 aniso 0.0 0.0 1.0"   "run 50000"
velocity all create $(2*v_T) ${seed} dist gaussian
velocity all create 1816 ${seed} dist gaussian
velocity all create 1816 1006 dist gaussian
fix npt all npt temp ${T} ${T} 0.1 aniso 0.0 0.0 1.0
fix npt all npt temp 908 ${T} 0.1 aniso 0.0 0.0 1.0
fix npt all npt temp 908 908 0.1 aniso 0.0 0.0 1.0
run 50000
