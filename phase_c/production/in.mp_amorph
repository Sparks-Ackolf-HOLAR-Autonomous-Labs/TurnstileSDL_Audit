# Amorphous-probe variant of chpc/in.mp_kappa2 (Phase C production,
# 2026-09-28): melt the random alloy at 3500 K (Tersoff-1989 melts near
# 2500 K for Si), quench to T over 100 ps, relax at T under NPT (iso),
# then run the IDENTICAL Muller-Plathe protocol. MPT_PE_ATOM after the
# quench records the structural state (crystal Si0.5Ge0.5 is about
# -4.20 eV/atom; amorphous sits about 0.1-0.2 eV/atom higher).
variable x     index 0.5
variable T     index 300
variable ncz   index 24
variable seed  index 20260925
variable ncxy  index 4
variable swapn index 50
variable pot   index SiCGe.tersoff
variable out   index mp_out

units metal
boundary p p p
variable a0 equal 5.431+(5.658-5.431)*v_x
lattice diamond ${a0}
region box block 0 ${ncxy} 0 ${ncxy} 0 ${ncz}
create_box 2 box
create_atoms 1 box
if "${x} > 0" then "set type 1 type/fraction 2 ${x} ${seed}"
mass 1 28.0855
mass 2 72.63
pair_style tersoff
pair_coeff * * ${pot} Si(D) Ge

timestep 0.001
thermo 10000
velocity all create 7000 ${seed} dist gaussian
fix melt all npt temp 3500 3500 0.1 iso 0.0 0.0 1.0
run 50000
unfix melt
fix quench all npt temp 3500 ${T} 0.1 iso 0.0 0.0 1.0
run 100000
unfix quench
fix npt all npt temp ${T} ${T} 0.1 iso 0.0 0.0 1.0
run 50000
unfix npt
print "MPT_PE_ATOM $(pe/atoms:%.5f)"

fix nve all nve
fix flux all thermal/conductivity ${swapn} z 20
run 100000
print "MPT_EWARM $(f_flux:%.6f)"

compute bins all chunk/atom bin/1d z lower 0.05 units reduced
fix prof all ave/chunk 10 100 1000 bins temp ave running overwrite file ${out}.profile
run 500000
print "MPT_EPROD $(f_flux:%.6f)"
print "MPT_BOX $(lx:%.4f) $(ly:%.4f) $(lz:%.4f)"
print "MPT_NATOMS $(atoms)"
print "MPT_META deck amorph x ${x} T ${T} ncz ${ncz} seed ${seed} prod_steps 500000 ncxy ${ncxy} swap ${swapn}"
