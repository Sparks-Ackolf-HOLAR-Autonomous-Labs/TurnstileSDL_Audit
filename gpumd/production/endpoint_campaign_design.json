 "acceptance": {
  "P1_linearity": "at each (system, T): |k(Fe_low) - k(Fe_high)| <= 2*sqrt(SE_low^2 + SE_high^2)",
  "P2_size": "Si 300 K: |k(16x8x8, Fe 1e-5) - k(8x8x8, Fe 1e-5)| <= 2*sqrt(SE^2 + SE^2) (seed SEs)",
  "P3_alloy_crosscheck": "x=0.5, 300 K HNEMD point within 2*sqrt(SE^2 + 0.10^2) of the rNEMD 1/L extrapolation 1.80 W/mK (0.10 = assumed rNEMD fit SE); pass -> strengthen witness, fail -> open a shard action on the MD party (does NOT block the restore, which is about endpoints)",
  "R1_exit": "exit status 0 and kappa.out has at least 90% of the expected lines",
  "R2_temperature": "mean production temperature within 2% of T",
  "R3_no_runaway": "drift z = (mean of last 20% of retained series - mean of first 20%) / (run SEM * sqrt(2)) must be < 3 (positive runaway is the documented Fe=1e-4 failure signature)",
  "R4_physical": "0 < run value < 2000 W/mK"
 },
 "analysis": {
  "per_point": "point = (system, T, Fe). Estimate = mean of per-run values over seeds; uncertainty SE = std over seeds / sqrt(n_seeds) (sample std, ddof=1); if fewer than 2 runs pass, the point is FAILED (no estimate)",
  "per_run": "kx = kx_in + kx_out per 1000-step interval; discard first 20%; 10 contiguous blocks; run value = mean of block means; run SEM = std(block means)/sqrt(10)",
  "per_state": "state = (system, T). Reported kappa = mean of the two Fe point estimates; SE = 0.5*sqrt(SE1^2+SE2^2)"
 },
