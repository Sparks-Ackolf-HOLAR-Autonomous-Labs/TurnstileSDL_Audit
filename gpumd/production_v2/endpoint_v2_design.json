{
 "acceptance": {
  "P1_linearity": "at each (system, T), 8x8x8: |k(Fe_low)-k(Fe_high)| <= 2*sqrt(SE_low^2+SE_high^2), SE as per_point",
  "P2_size": "Si 300 K, Fe 1e-5: |k(16x8x8)-k(8x8x8)| <= 2*sqrt(SE^2+SE^2), SE as per_point",
  "R1_exit": "exit status 0 and kappa.out has >= 90% of expected lines",
  "R2_temperature": "mean production temperature within 2% of T",
  "R3_no_runaway": "drift z = (mean of last 20% of retained series - mean of first 20%) / (run SEM*sqrt(2)) < 3",
  "R4_physical": "0 < run value < 2000 W/mK"
 },
 "analysis": {
  "per_point": "point = (system, T, Fe, cells). Estimate = mean of passing run values; SE = max(std over runs/sqrt(n), sqrt(sum run SEM^2)/n) (seed SE floored at the pooled within-run SEM); FAILED if fewer than 3 runs pass (2 for the 3-run size point)",
  "per_run": "kx = kx_in + kx_out per 1000-step interval; discard first 20%; 10 contiguous blocks; run value = mean of block means; run SEM = std(block means)/sqrt(10)",
  "per_state": "state = (system, T). Reported kappa = mean of the two Fe point estimates; SE = 0.5*sqrt(SE1^2+SE2^2)"
 },
 "campaign": "gpumd-endpoint-v2-2026-09-29",
 "code": {
  "binary": "/uufs/chpc.utah.edu/common/home/u1496771/mat_theory/gpumd_v2/GPUMD/src/gpumd",
