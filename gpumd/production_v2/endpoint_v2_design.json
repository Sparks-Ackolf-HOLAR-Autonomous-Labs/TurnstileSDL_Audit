 "protocol": {
  "driving_direction": "x (kappa = kx_in + kx_out)",
  "execution": "CHPC guest GPU partitions only (notchpeak-gpu-guest / granite-gpu-guest, account owner-gpu-guest); one SLURM array per stage, one run per task, 1 GPU per task; grn061 / sparks-gpu-grn and the DGX are not used",
  "hardware_heterogeneity": "whatever guest GPU SLURM assigns; the GPU model is recorded per run (nvidia-smi) and reported, never gated",
  "model": "diamond conventional cells (gpumd/make_model.py)",
  "npt_equilibration": "ensemble npt_ber T T 100 0 100 1000 for 100 ps",
  "nvt_equilibration": "ensemble nvt_nhc T T 100 for 50 ps",
  "preemption": "a preempted or node-failed task is requeued and restarts from scratch with the same seed; attempts are counted per run and reported",
  "production": "ensemble nvt_nhc T T 100 + compute_hnemd 1000 Fe 0 0 + dump_thermo 10000, for production_ns",
  "stage_order": [
   "V1-anchor-300K",
   "V2-size-check",
   "V3-highT"
  ],
  "time_step_fs": 1,
  "velocity": "velocity T seed <seed>"
 },
